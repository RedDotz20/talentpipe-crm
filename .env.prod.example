# Copy to .env and replace every value before first `docker compose -f docker-compose.prod.yml up -d --build`

POSTGRES_USER=talentpipe
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=talentpipe
DATABASE_URL=postgres://talentpipe:change-me-strong-password@postgres:5432/talentpipe
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-long-random-secret-1
JWT_REFRESH_SECRET=change-me-long-random-secret-2
MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY must match the MinIO root credentials above
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=resumes
CORS_ORIGIN=https://your-domain.example
